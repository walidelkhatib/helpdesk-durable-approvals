# Copy to .env.local for local development. Never commit .env.local.

# Vercel AI Gateway key (Vercel dashboard → AI Gateway → API Keys).
# Only the chat needs it; the tests and the curl demos don't.
AI_GATEWAY_API_KEY=

# Optional: any AI Gateway model ID. Defaults to openai/gpt-5-mini (free tier).
# AI_MODEL=anthropic/claude-sonnet-5.5

# How long an approval waits before it expires. 120 seconds for the demo.
# APPROVAL_TIMEOUT_SECONDS=120

# Restate server (defaults match `npm run restate`).
# RESTATE_INGRESS_URL=http://localhost:8080
# RESTATE_ADMIN_URL=http://localhost:9070
# SERVICE_URL=http://localhost:9080
